# Copy to .env (git-ignored) and fill in. Never commit .env.
#   cp .env.example .env
#
# Without a key, the system replays the committed Grok recording, so none of
# this is needed to run the sample invoices.

# xAI API key for live Grok. Leave empty to use the recording.
XAI_API_KEY=

# Model names have no defaults in code. These are the models the committed
# recording was made with.
GROK_EXTRACTION_MODEL=grok-4.7   # reads TXT and PDF invoices
GROK_REASONING_MODEL=grok-4.7    # shared by the VP and the Critic

# Dashboard only (optional).
# Starting provider in the dashboard: grok or replay. Unset means auto
# (Grok when XAI_API_KEY is set, otherwise the recording).
# ACME_UI_PROVIDER=replay
# Alternative settings file, e.g. to point the dashboard at a scratch database.
# ACME_SETTINGS=/path/to/settings.toml
